// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  salaries  Salary[]

  @@map("company")
}

model Occupation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  salaries  Salary[]

  @@map("occupation")
}

model Salary {
  id            String   @id @default(uuid())
  companyId     Int      @map("company_id")
  occupationId  String   @map("occupation_id") @db.Uuid
  age           Int
  grade         String?
  overtimeHours Decimal? @map("overtime_hours") @db.Decimal(10, 2)
  annualSalary  Decimal  @map("annual_salary") @db.Decimal(12, 2)
  baseSalary    Decimal  @map("base_salary") @db.Decimal(12, 2)
  bonus         Decimal? @db.Decimal(12, 2)
  stockOptions  Decimal? @map("stock_options") @db.Decimal(12, 2)
  rsu           Decimal? @db.Decimal(12, 2)

  company    Company    @relation(fields: [companyId], references: [id])
  occupation Occupation @relation(fields: [occupationId], references: [id])

  @@map("salary")
}

model BulkJob {
  id            String   @id @default(uuid())
  type          String
  status        String   @default("pending")
  totalRows     Int      @map("total_rows")
  processedRows Int      @default(0) @map("processed_rows")
  successRows   Int      @default(0) @map("success_rows")
  failedRows    Int      @default(0) @map("failed_rows")
  inputData     String   @map("input_data") @db.Text
  errorCsv      String?  @map("error_csv") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bulk_job")
}
